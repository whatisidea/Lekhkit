# Copy to .env.local for development. On Vercel add the same names under Project Settings > Environment Variables.
# NEXT_PUBLIC_ values are baked in at build time, so redeploy after changing one.

# Google Tag Manager container ID (GTM-XXXXXXX). Leave empty to load no analytics at all.
NEXT_PUBLIC_GTM_ID=

# The live address of the site. Used for the sitemap, robots.txt, canonical link and social cards.
NEXT_PUBLIC_SITE_URL=https://lekhkit.com

# Google Search Console verification token (with or without the "google-site-verification=" prefix). Optional.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
